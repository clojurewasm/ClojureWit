;; The S3 corpus — doc/design/0022 B's committed artifact; the harness is
;; test/cljwit/corpus_test.clj (doc/design/0023). Every special form lands
;; with its entries in the same commit, and any "X works" claim leaves its
;; probing expression here.
;;
;; Authoring rules for day one (0023):
;;   - entries are scalar: the last form's value is a long (0022 B.3)
;;   - literals, intermediates AND results all stay inside i31
;;     (-2^30 .. 2^30-1) — the boxed-i64 lane is open (0022 C), and a
;;     violation traps `unreachable`, which the harness reports as an
;;     out-of-contract entry, not a compiler divergence
;;   - an entry that expects a throw needs its row in trap_table.edn
[{:id "lit"             :forms [42]}
 {:id "lit-neg"         :forms [-7]}
 {:id "lit-i31-max"     :forms [1073741823]}
 {:id "lit-i31-min"     :forms [-1073741824]}
 {:id "add-nary"        :forms [(+ 1 2 3 4)]}
 {:id "sub-chain"       :forms [(- 100 1 2 3)]}
 {:id "neg-unary"       :forms [(- 5)]}
 {:id "mul"             :forms [(* 6 7)]}
 {:id "arith-nested"    :forms [(+ (* 3 4) (- 10 (quot 9 2)))]}
 {:id "quot-pos"        :forms [(quot 17 5)]}
 {:id "quot-neg"        :forms [(quot -17 5)]}
 {:id "if-lt"           :forms [(if (< 1 2) 10 20)]}
 {:id "if-lt-false"     :forms [(if (< 2 1) 10 20)]}
 {:id "if-nil"          :forms [(if nil 1 2)]}
 {:id "if-false"        :forms [(if false 1 2)]}
 {:id "if-zero-truthy"  :forms [(if 0 1 2)]}
 {:id "if-untaken-arm"  :forms [(if true 3 (quot 1 0))]}
 {:id "loop-countdown"  :forms [(loop [i 10 acc 0]
                                  (if (< 0 i) (recur (- i 1) (+ acc i)) acc))]}
 {:id "loop-fib-iter"   :forms [(loop [n 10 a 0 b 1]
                                  (if (< 0 n) (recur (- n 1) b (+ a b)) a))]}
 ;; recur rebinds simultaneously: a sequential-assignment bug makes the
 ;; swap collapse (a=b, then b=that same value) and this entry catch it.
 {:id "loop-recur-simultaneous"
  :forms [(loop [a 1 b 2 n 3]
            (if (< 0 n) (recur b a (- n 1)) (- (* a 10) b)))]}
 {:id "loop-nested"     :forms [(loop [i 3 total 0]
                                  (if (< 0 i)
                                    (recur (- i 1)
                                           (+ total (loop [j i s 0]
                                                      (if (< 0 j) (recur (- j 1) (+ s j)) s))))
                                    total))]}
 {:id "let-shadow"      :forms [(let [x 1] (let [x (+ x 1)] (* x 10)))]}
 {:id "let-sequential"  :forms [(let [x 2 y (+ x 3)] (* x y))]}
 {:id "top-level-forms" :forms [(+ 1 1) (+ 2 2)]}
 {:id "def-ref"         :forms [(def x 5) (+ x 1)]}
 {:id "def-uses-def"    :forms [(def x 5) (def y (+ x 3)) (+ x y)]}
 {:id "def-redef"       :forms [(def x 1) (def x 2) x]}
 ;; A throwing re-def: both lanes abort the entry at form 2, and row 1
 ;; licenses the comparison. That the old root survives (0022 D, the
 ;; sibling's recorded bug) is unobservable until try/catch exists —
 ;; claimed nowhere until it does.
 {:id "def-redef-throws" :forms [(def x 5) (def x (quot 1 0)) x]}
 {:id "trap-div-zero"   :forms [(quot 1 0)]}
 ;; --- fn (0024). An entry carries :modes when only one mode can
 ;; express it; default is both.
 {:id "fn-anon-call"    :forms [((fn [x y] (+ x y)) 2 3)]}
 {:id "fn-zero-arity"   :forms [((fn [] 7))]}
 {:id "fn-multi-arity"  :forms [(let [f (fn ([x] x) ([x y] (* x y)))]
                                  (+ (f 5) (f 3 4)))]}
 {:id "fn-closure"      :forms [(let [a 10] ((fn [x] (+ x a)) 5))]}
 {:id "fn-closure-shared" :forms [(let [a 2]
                                    (let [g (fn [x] (* a x))]
                                      (+ (g 3) (g 4))))]}
 ;; Partial shadowing: the outer x is captured, the inner x is not —
 ;; exactly what uniquified free-variable computation exists for.
 {:id "fn-capture-shadow" :forms [(let [x 1]
                                    ((fn [y] (+ x (let [x 10] (+ x y)))) 5))]}
 {:id "fn-named-fact"   :forms [((fn fact [n] (if (< n 2) 1 (* n (fact (- n 1))))) 10)]}
 {:id "fn-method-recur" :forms [((fn [n acc] (if (< 0 n) (recur (- n 1) (+ acc n)) acc)) 10 0)]}
 {:id "fn-higher-order" :forms [((fn [f x] (f (f x))) (fn [n] (+ n 3)) 10)]}
 {:id "fn-def-call"     :forms [(def dbl (fn [x] (* 2 x))) (dbl 21)]}
 {:id "fn-as-value"     :forms [(def dbl (fn [x] (* 2 x)))
                                ((fn [g] (+ (g 3) (g 4))) dbl)]}
 ;; The roadmap's S3 sentence, verbatim shape: defn fib runs everywhere.
 {:id "fn-defn-fib"     :forms [(defn fib [n] (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
                                (fib 20)]}
 ;; Depth pin: 3000 frames, ~2.8x under the shallowest measured band for
 ;; this frame shape — wasmtime ~8-10k, V8 ~10.3-10.7k, the oracle JVM
 ;; ~8.5-9.2k (0024 §9).
 {:id "fn-depth-safe"   :forms [(defn down [n] (if (< 0 n) (down (- n 1)) 42))
                                (down 3000)]}
 ;; Deliberate exhaustion on every lane, including the oracle: trap row 2.
 {:id "fn-stack-exhaust" :forms [(defn down [n] (if (< 0 n) (down (- n 1)) 42))
                                 (down 10000000)]}
 ;; Redefinition taking effect is the open world's point (0009); prod
 ;; direct-links and refuses, so this entry is dev-only (0024 §10).
 {:id "fn-redef-dev"    :modes [:dev]
  :forms [(def f (fn [] 1)) (def f (fn [] 2)) (f)]}
 ;; ^:redef opts out of direct linking in prod (0004's exclusion rule),
 ;; so redefinition works in both modes.
 {:id "fn-redef-marked" :forms [(def ^:redef f (fn [] 1))
                                (def ^:redef f (fn [] 2))
                                (f)]}
 ;; --- the boxed-i64 lane (0025): longs outside i31 are $BoxI64 and
 ;; fixnums are canonical. True 64-bit overflow stays out of contract
 ;; until the throw representation lands.
 {:id "box-lit"          :forms [2147483648]}
 {:id "box-lit-long-max" :forms [9223372036854775807]}
 {:id "box-lit-long-min" :forms [-9223372036854775808]}
 {:id "box-cross-up"     :forms [(+ 1073741823 1)]}
 ;; Comes back under the i31 boundary: exercises the canonicalizing arm.
 {:id "box-canon-down"   :forms [(- (+ 1073741823 1) 1)]}
 {:id "box-mul"          :forms [(* 100000 100000)]}
 {:id "box-quot-down"    :forms [(quot 10000000000 100000)]}
 ;; JVM long division wraps silently at MIN / -1; so do we (0025).
 {:id "box-quot-min-neg1" :forms [(quot -9223372036854775808 -1)]}
 {:id "box-lt"           :forms [(if (< 2147483648 2147483649) 1 2)]}
 {:id "box-mixed-lt"     :forms [(if (< 5 2147483648) 1 2)]}
 ;; The stop-condition domain (0022 C, iteratively): fib(46) is the
 ;; first value off i31. The upper entry is 91, not 92: this loop shape
 ;; computes fib(n+1) into b on the last iteration, and at n = 92 real
 ;; clojure throws "long overflow" one step ahead of the returned value
 ;; — the oracle caught exactly that when this entry first said 92.
 {:id "box-fib-46"       :forms [(defn fib-iter [n]
                                   (loop [i n a 0 b 1]
                                     (if (< 0 i) (recur (- i 1) b (+ a b)) a)))
                                 (fib-iter 46)]}
 {:id "box-fib-91"       :forms [(defn fib-iter [n]
                                   (loop [i n a 0 b 1]
                                     (if (< 0 i) (recur (- i 1) b (+ a b)) a)))
                                 (fib-iter 91)]}]
